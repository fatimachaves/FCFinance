@inject ApiTokenService ApiTokens
@inject IConfiguration Config
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FCFinance</title>
    @* Token para o JavaScript chamar a API (ver wwwroot/js/apiAuth.js) *@
    <meta name="fcf-api-token" content="@ApiTokens.CriarPara(User)" />
    @* Endereço da API (appsettings "Api:BaseUrl"), para o JavaScript não ter "localhost" fixo *@
    <meta name="fcf-api-url" content="@(Config["Api:BaseUrl"]?.TrimEnd('/'))/api" />
    <script src="~/js/apiAuth.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">

        @* ===== MENU LATERAL (todas as páginas logadas). No celular vira uma gaveta aberta pelo botão ☰. =====
           Só entram telas que existem. Os itens de Transações abrem direto a aba certa (#nova, #metas...). *@
        <aside class="sidebar" id="sidebar" aria-label="Menu">
            <button class="sidebar-toggle" id="sidebar-toggle" type="button"
                    aria-label="Recolher menu" aria-expanded="true" title="Recolher menu">‹</button>

            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">↗</span>
                <span class="brand-name">FC<span>Finance</span></span>
                <small>Seu dinheiro<br>no controle</small>
            </a>

            <nav class="nav-menu" aria-label="Menu principal">
                <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><span class="nav-icon">⌂</span>Dashboard</a>
                <a class="nav-link" asp-controller="Transacoes" asp-action="Index" asp-fragment="nova" data-hash="nova"><span class="nav-icon">⊕</span>Nova transação</a>
                <a class="nav-link" asp-controller="Transacoes" asp-action="Index" asp-fragment="historico" data-hash="historico"><span class="nav-icon">◷</span>Histórico</a>
                <a class="nav-link" asp-controller="Transacoes" asp-action="Index" asp-fragment="metas" data-hash="metas"><span class="nav-icon">◎</span>Metas</a>
                <a class="nav-link" asp-controller="Transacoes" asp-action="Index" asp-fragment="categorias" data-hash="categorias"><span class="nav-icon">▥</span>Categorias</a>
                <a class="nav-link @Active("Conta")" asp-controller="Conta" asp-action="MinhaConta"><span class="nav-icon">⚙</span>Minha conta</a>
                @if (User.IsInRole(Perfis.Admin))
                {
                    <a class="nav-link @Active("Usuarios")" asp-controller="Usuarios" asp-action="Index"><span class="nav-icon">◉</span>Usuários</a>
                }
            </nav>

            <div class="profile">
                <div class="avatar">@(string.IsNullOrEmpty(User.Nome()) ? "?" : User.Nome().Substring(0, 1).ToUpper())</div>
                <span id="user-name">@User.Nome()</span>
                <form asp-controller="Conta" asp-action="Sair" method="post" class="inline-form">
                    <button type="submit" class="logout" title="Sair" aria-label="Sair">↪</button>
                </form>
            </div>
        </aside>

        @* ===== CONTEÚDO DA PÁGINA ===== *@
        <main class="main-content" role="main">
            <button class="mobile-menu" id="mobile-menu" type="button"
                    aria-label="Abrir menu" aria-expanded="false" aria-controls="sidebar">☰</button>

            @* page-body ocupa o espaço livre e empurra o rodapé para o fim da página *@
            <div class="page-body">
                @RenderBody()
            </div>

            <footer class="page-footer">&copy; @DateTime.Now.Year FCFinance - Todos os direitos reservados.</footer>
        </main>
    </div>

    <script src="~/js/sidebar.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
