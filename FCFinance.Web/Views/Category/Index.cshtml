
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>FCFinance - Categorias</title>
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>

    <main class="container">

        <header class="header">
            <div>
                <h1>Minhas categorias</h1>
                <p>Gerencie suas categorias financeiras.</p>
            </div>
        </header>

        <section class="card">

            <h2 id="formTitle">Cadastrar categoria</h2>

            <form id="categoryForm">

                <input type="hidden" id="categoryId">

                <div class="form-group">
                    <label for="name">Nome da categoria</label>
                    <input
                        type="text"
                        id="name"
                        placeholder="Ex: Alimentação"
                        required>
                </div>

                <div class="form-group">
                    <label for="categoryTypeId">Tipo da categoria</label>
                    <input
                        type="number"
                        id="categoryTypeId"
                        placeholder="Informe o ID do tipo"
                        min="1"
                        required>
                </div>

                <div class="buttons">
                    <button type="submit" id="saveButton">
                        Cadastrar
                    </button>

                    <button
                        type="button"
                        id="cancelButton"
                        class="cancel"
                        hidden>
                        Cancelar edição
                    </button>
                </div>

            </form>

        </section>

        <section class="card">

            <div class="table-header">
                <h2>Categorias cadastradas</h2>

                <button
                    type="button"
                    class="refresh"
                    onclick="listCategories()">
                    Atualizar lista
                </button>
            </div>

            <div class="table-container">

                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Tipo ID</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody id="categoriesTable">
                    </tbody>
                </table>

            </div>

            <p id="message"></p>

        </section>

    </main>
    <script src="~/js/category.js"></script>
    <script src="~/js/api.js"></script>
</body>
</html>
